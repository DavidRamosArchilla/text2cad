.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# large, reproducible from pinned sources: never commit
/data/
outputs/
clusters/

# results registry: summaries are tracked (they sync between clusters through git),
# per-sample dumps stay local
results/runs/*/samples.jsonl.gz

# Obsidian opens docs/ as a vault and keeps per-user state there
docs/.obsidian/
